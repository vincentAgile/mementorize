# Settings for docker compose (phase 7). Copy this file to .env, next to
# docker-compose.yml: compose reads it automatically. .env is ignored by git.

# Signs the session tokens (JWT). Required. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"

# Sessions (MEM-85), in seconds: a short access token, renewed silently
# with a renewal token as long as the app is used. Without any use for
# REFRESH_TOKEN_TTL, the user logs in again.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# PostgreSQL credentials. Only read when the database volume is created:
# changing them afterwards doesn't change the existing database's password.
# On the server, use a real password (e.g. `openssl rand -hex 24`).
POSTGRES_USER=mementorize
POSTGRES_PASSWORD=mementorize
POSTGRES_DB=mementorize

# Port of the web app on the host, locally: http://localhost:3001 (unused in
# production, where Traefik is the only way in)
WEB_PORT=3001

# E-mail reminders of the due reviews (phase 11). Optional: without
# SMTP_HOST, no e-mail is sent. On the server: the SMTP of the e-mail
# account (OVH: ssl0.ovh.net, port 465). Locally, Mailpit catches everything
# (`docker compose --profile mail up`, then http://localhost:8025):
#SMTP_HOST=mailpit
#SMTP_PORT=1025
#SMTP_USER="rappels@mondomaine.fr"
#SMTP_PASSWORD=""
# Sender shown in the e-mails (SMTP_USER if empty), e.g. "Mementorize <rappels@mondomaine.fr>"
#MAIL_FROM=""

# Pronunciation of the vocabulary (MEM-39), generated by Kokoro. Optional:
# without KOKORO_URL, the browser's voices are used. Locally:
# `docker compose --profile tts up`. In production, Kokoro is always started
# and KOKORO_URL set (an empty KOKORO_URL= turns it off). Voice: af_heart
# (American) by default; changing it regenerates every audio when the API
# starts (deploy/README.md).
#KOKORO_URL=http://kokoro:8880
#KOKORO_VOICE=af_heart

# --- Production only (docker-compose.prod.yml, see deploy/README.md) -------
# Domain name of the app, whose DNS record points to the server. Traefik
# routes the requests for this name to the web container and gets its
# HTTPS certificate.
#APP_DOMAIN="mementorize.example.fr"

# Makes plain `docker compose ...` use both files on the server, instead of
# typing `-f docker-compose.yml -f docker-compose.prod.yml` every time.
#COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Commit whose images run in production. Don't edit it: each deployment
# (deploy/release.sh) writes it at the end of this file.
#IMAGE_TAG=
