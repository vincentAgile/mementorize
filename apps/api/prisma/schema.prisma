generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  items        Item[]

  @@map("users")
}

enum ItemType {
  Quote
  Vocabulary
  MindMap
}

/// Something to memorize. Every type shares this table; what differs from
/// one type to another lives in `content` (a jsonb column), whose shape is
/// checked by the API (see src/items/item-content.ts):
///   Quote      -> { text, author, source }
///   Vocabulary -> { word, translation, example }
///   MindMap    -> { nodes: [{ id, parentId, label, position: { x, y } }] }
model Item {
  id        String   @id @default(uuid())
  type      ItemType
  content   Json
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("items")
}

/// Which "side" of an item a card asks about. A quote has one card, a
/// vocabulary word has two (one per direction), a mind map one per branch
/// (child of the root), each with its own schedule.
enum CardKind {
  QuoteRecall
  EnglishToFrench
  FrenchToEnglish
  BranchRecall
}

// Same names as ts-fsrs's State enum, so mapping is a simple lookup.
enum CardState {
  New
  Learning
  Review
  Relearning
}

// ts-fsrs's Rating enum, minus "Manual" (not used by the app).
enum ReviewRating {
  Again
  Hard
  Good
  Easy
}

/// Spaced-repetition state (FSRS) of one side of an item: when to review it
/// next, and how well it is known.
model Card {
  id            String      @id @default(uuid())
  itemId        String
  item          Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind          CardKind
  /// Mind maps only: id of the branch node (in items.content) this card asks
  /// about. Null for the other kinds.
  nodeId        String?
  due           DateTime
  stability     Float
  difficulty    Float
  scheduledDays Int
  learningSteps Int
  reps          Int
  lapses        Int
  state         CardState
  lastReview    DateTime?
  reviewLogs    ReviewLog[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // PostgreSQL treats NULLs as distinct in a unique index: for the cards
  // without nodeId (quotes, vocabulary) this no longer prevents two cards of
  // the same kind on one item. Only ItemsService creates cards, and it
  // creates each one once.
  @@unique([itemId, kind, nodeId])
  @@index([due])
  @@map("cards")
}

/// One row per self-assessment: the review history of a card.
model ReviewLog {
  id            String       @id @default(uuid())
  cardId        String
  card          Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating        ReviewRating
  state         CardState
  due           DateTime
  stability     Float
  difficulty    Float
  scheduledDays Int
  learningSteps Int
  reviewedAt    DateTime

  @@index([cardId])
  @@map("review_logs")
}
