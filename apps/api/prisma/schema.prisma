generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  /// First name and last name, optional (MEM-11): the initials of the
  /// avatar and the name shown in the account menu.
  firstName    String?
  lastName     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// The last use of the app (MEM-83): an authenticated call, a login, a
  /// renewal of the session; to the hour. Null: not used since it exists.
  lastActiveAt DateTime?
  items        Item[]
  /// The FSRS weights optimized on the user's history, per space (MEM-76).
  fsrsParameters FsrsParameters[]

  /// E-mail reminder of the due reviews (phase 11), once a day at most.
  /// Off until the user turns it on in the settings.
  reminderEnabled    Boolean @default(false)
  /// Local hour (0-23), in reminderTimeZone, from which it is sent.
  reminderHour       Int     @default(8)
  /// IANA time zone (e.g. Europe/Paris), sent by the user's browser.
  reminderTimeZone   String  @default("Europe/Paris")
  /// Local date (YYYY-MM-DD) of the last day handled: at most one reminder
  /// a day, even with two API containers running during a deployment.
  reminderLastSentOn String?

  /// The subject space opened on arrival (MEM-6): `/`, after login and from
  /// the reminder e-mail.
  homeSpace ItemType @default(Vocabulary)
  /// The translation service opened by the translate buttons (MEM-44).
  translator Translator @default(DeepL)
  /// Show, under each rating button of a review, when the card would come
  /// back (MEM-49). Off by default, existing accounts included.
  showReviewDelays Boolean @default(false)
  /// Separator of the CSV files, export and import (MEM-80): any single
  /// character but the double quote and the line breaks; a semicolon, for
  /// Excel in French, by default.
  csvDelimiter String @default(";")
  /// Number of items per page of the vocabulary list (MEM-58): 20, 50 or 100.
  vocabularyPageSize Int @default(20)
  /// Target retention of each space (MEM-75), in percent: 85, 90 or 95. A
  /// card comes back when the probability of remembering it falls to it.
  vocabularyRetention Int @default(90)
  quoteRetention      Int @default(90)
  mindMapRetention    Int @default(90)

  @@map("users")
}

/// Services of the translate buttons of the vocabulary forms (MEM-44).
enum Translator {
  DeepL
  Google
}

enum ItemType {
  Quote
  Vocabulary
  MindMap
}

/// Learning state of an item (MEM-15): a new vocabulary word, or a new quote
/// (MEM-67), is `ToLearn` until the learning process (MEM-21, MEM-68) moves
/// it to `Learning`, the only state that is reviewed; `Learned` takes it out
/// of the review (MEM-22).
enum LearningStatus {
  /// MEM-61: not scheduled for learning yet (an import, for instance).
  Waiting
  ToLearn
  Learning
  Learned
}

/// Something to memorize. Every type shares this table; what differs from
/// one type to another lives in `content` (a jsonb column), whose shape is
/// checked by the API (see src/items/item-content.ts):
///   Quote      -> { text, author, source }
///   Vocabulary -> { word, translation, example }
///   MindMap    -> { nodes: [{ id, parentId, label, position: { x, y } }] }
model Item {
  id        String   @id @default(uuid())
  type      ItemType
  content   Json
  /// Where the item stands in its learning (MEM-15). Vocabulary and quotes
  /// (MEM-67) move between the four states; mind maps are always `Learning`.
  /// Only the cards of `Learning` items are reviewed and counted.
  learningStatus LearningStatus @default(Learning)
  /// MEM-61: position in the learning queue (1, 2, 3…), for the `ToLearn`
  /// items only; null otherwise. One queue per type, vocabulary and quotes
  /// (MEM-67). No gap, no duplicate: kept so by src/learning/learning-queue.ts.
  learnPosition Int?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     Card[]
  /// Vocabulary only (MEM-39): the audio of the English, generated by Kokoro.
  pronunciation Pronunciation?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("items")
}

/// The pronunciation of a vocabulary item (MEM-39): the audio of its English,
/// generated once by Kokoro on the server. `text` and `voice` are what it was
/// generated from: when the English or the voice changes, it no longer
/// matches and is generated again (never served while it doesn't match).
model Pronunciation {
  itemId    String   @id
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text      String
  voice     String
  audio     Bytes
  mimeType  String
  createdAt DateTime @default(now())

  @@map("pronunciations")
}

/// Which "side" of an item a card asks about. A quote has one card, a
/// vocabulary word has two (one per direction), a mind map one per branch
/// (child of the root), each with its own schedule.
enum CardKind {
  QuoteRecall
  EnglishToFrench
  FrenchToEnglish
  BranchRecall
}

// Same names as ts-fsrs's State enum, so mapping is a simple lookup.
enum CardState {
  New
  Learning
  Review
  Relearning
}

// ts-fsrs's Rating enum, minus "Manual" (not used by the app), plus
// `Learned`: not a grade, it records in the history that a vocabulary item
// was marked as learned during a review (MEM-22). The scheduler only ever
// takes the four grades (type `Grade`).
enum ReviewRating {
  Again
  Hard
  Good
  Easy
  Learned
}

/// Spaced-repetition state (FSRS) of one side of an item: when to review it
/// next, and how well it is known.
model Card {
  id            String      @id @default(uuid())
  itemId        String
  item          Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind          CardKind
  /// Mind maps only: id of the branch node (in items.content) this card asks
  /// about. Null for the other kinds.
  nodeId        String?
  due           DateTime
  stability     Float
  difficulty    Float
  scheduledDays Int
  learningSteps Int
  reps          Int
  lapses        Int
  state         CardState
  lastReview    DateTime?
  /// Mind map branches (MEM-48): when « Appris » took the card out of the
  /// review, its schedule kept as it was. Null while reviewed. Vocabulary and
  /// quotes (MEM-67) are learned per item instead (Item.learningStatus).
  learnedAt     DateTime?
  reviewLogs    ReviewLog[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // PostgreSQL treats NULLs as distinct in a unique index: for the cards
  // without nodeId (quotes, vocabulary) this no longer prevents two cards of
  // the same kind on one item. Only ItemsService creates cards, and it
  // creates each one once.
  @@unique([itemId, kind, nodeId])
  @@index([due])
  @@map("cards")
}

/// One row per self-assessment: the review history of a card.
model ReviewLog {
  id            String       @id @default(uuid())
  cardId        String
  card          Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating        ReviewRating
  state         CardState
  due           DateTime
  stability     Float
  difficulty    Float
  scheduledDays Int
  learningSteps Int
  reviewedAt    DateTime

  @@index([cardId])
  @@map("review_logs")
}

/// MEM-76: the state of an optimization of the FSRS weights.
enum OptimizationStatus {
  Running
  Succeeded
  Failed
}

/// The FSRS weights of a user for one space (MEM-76), optimized on their
/// review history with the official FSRS optimizer; and the state of the
/// last optimization, run in the background. No row, or no weights: the
/// default weights.
model FsrsParameters {
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ItemType
  /// The 21 weights of FSRS-6; empty: the default weights.
  weights     Float[]             @default([])
  /// When the weights in use were optimized; null with the default weights.
  optimizedAt DateTime?
  /// How many reviews they were optimized on.
  reviewCount Int?
  /// The last optimization: running, done, or failed (the weights in use stay).
  status      OptimizationStatus?
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?

  @@id([userId, type])
  @@map("fsrs_parameters")
}
