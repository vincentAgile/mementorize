DATABASE_URL="postgresql://mementorize:mementorize@localhost:5432/mementorize?schema=public"
PORT=3000

# JWT signing secret. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"
# Sessions (MEM-85), in seconds: access token (15 min), renewal token (30 days, sliding)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Administration console (MEM-82): off without ADMIN_JWT_SECRET (must differ from JWT_SECRET)
ADMIN_JWT_SECRET=""
# Encrypts the two-step login keys (MEM-86): 64 hex characters (openssl rand -hex 32)
ADMIN_TOTP_ENCRYPTION_KEY=""
ADMIN_SESSION_TTL=7200

# E-mail reminders (phase 11). Optional: without SMTP_HOST, nothing is sent.
# Mailpit catches the e-mails locally (`docker compose --profile mail up -d
# mailpit`, then http://localhost:8025).
#SMTP_HOST=127.0.0.1
#SMTP_PORT=1025
#SMTP_USER=""
#SMTP_PASSWORD=""
#MAIL_FROM="Mementorize <rappels@localhost>"
# Address of the web app, for the links of the e-mails.
APP_URL=http://localhost:3001
