# Domain name of Umami, whose DNS record (type A) points to the server, like
# the app's.
STATS_DOMAIN="stats.mondomaine.fr"

# Secrets, each generated once on the server, e.g.:
#   openssl rand -hex 24   (password, secret)    openssl rand -hex 32   (2FA key)
UMAMI_DB_PASSWORD=""
UMAMI_APP_SECRET=""
UMAMI_2FA_KEY=""
