# Settings of the Traefik stack. Copy this file to .env (same folder) on the
# server. .env is ignored by git.

# Contact address given to Let's Encrypt (expiry notices, problems).
ACME_EMAIL="you@example.com"

# While testing, use Let's Encrypt's staging server: its certificates aren't
# trusted by browsers (warning), but its rate limits are much higher. Once
# everything works: comment this line out, delete the stored certificates
# (docker compose down && docker volume rm traefik_letsencrypt) and restart.
#ACME_CA_SERVER="https://acme-staging-v02.api.letsencrypt.org/directory"
