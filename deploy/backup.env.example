# Settings of the backup and of the heartbeat (phase 11), read by their
# systemd services. On the server, in ~/.config/mementorize/backup.env
# (chmod 600): it holds a secret URL. Guide: deploy/README.md.

# Encrypted copy off the server: an rclone remote (rclone config). Empty: the
# backups stay on the server only.
BACKUP_REMOTE="sauvegardes:"
# Days kept off the server.
BACKUP_REMOTE_DAYS=30

# healthchecks.io: ping URL of the "backup" check (daily)...
HC_BACKUP_URL="https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# ...and of the "heartbeat" check (every 5 minutes).
HC_HEARTBEAT_URL="https://hc-ping.com/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"

# Address of the app, checked by the heartbeat.
APP_URL="https://mementorize.mondomaine.fr"
