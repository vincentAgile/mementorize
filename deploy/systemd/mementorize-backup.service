# Daily database backup (phase 11): see deploy/backup.sh.
# Installed by copying it to /etc/systemd/system (deploy/README.md).
[Unit]
Description=Mementorize: database backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=-/home/ubuntu/.config/mementorize/backup.env
ExecStart=/home/ubuntu/mementorize/deploy/backup.sh
